        <mxCell id="T6Q7dnKm5M2fOwGxogHJ-1916" value="Нарушение работы компании, которое повлечет прямой материальный ущерб" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#CC0000;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=center;spacing=5;fontStyle=0;arcSize=7;perimeterSpacing=2;" vertex="1" parent="1">
